# Oystr — Environment Variables
#
# Copy this file to .env.local and fill in your TfL API key.
# Register for free at: https://api-portal.tfl.gov.uk
#
# Without key: 50 requests/min (enough for development)
# With key:    500 requests/min (REQUIRED for production)
#
# IMPORTANT: Also set this as an environment variable in Vercel
# (Settings > Environment Variables) for the deployed app.

TFL_APP_KEY=your_primary_api_key_here
