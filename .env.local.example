# Oystr — Environment Variables
#
# Copy this file to .env.local and fill in your API keys.
#
# IMPORTANT: Also set these as environment variables in Vercel
# (Settings > Environment Variables) for the deployed app.

# ------------------------------------------------------------------
# TfL API (London transport: tube, bus, DLR, Overground, Elizabeth)
# Register for free at: https://api-portal.tfl.gov.uk
# Without key: 50 requests/min (enough for development)
# With key:    500 requests/min (REQUIRED for production)
# ------------------------------------------------------------------
TFL_APP_KEY=your_tfl_primary_api_key_here

# ------------------------------------------------------------------
# Rail Data Marketplace (National Rail long-distance live departures)
# Register for free at: https://raildata.org.uk
# Then subscribe to "Live Departure Board Service (LDBWS) - Public"
# and copy your API key below.
#
# Without this key the Rail tab shows a friendly
# "service unavailable" message — the rest of the app still works.
# ------------------------------------------------------------------
RDM_API_KEY=your_rdm_api_key_here
