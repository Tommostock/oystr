# Oystr — Environment Variables
#
# Copy this file to .env.local and fill in your TfL API credentials.
# Register for free at: https://api-portal.tfl.gov.uk
#
# Without keys: 50 requests/min (enough for development)
# With keys:    500 requests/min (recommended for production)

TFL_APP_KEY=your_primary_api_key_here
